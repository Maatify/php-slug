{
  "name": "maatify/php-slug",
  "description": "Scoped slug lifecycle and canonicalization for PHP applications.",
  "keywords": [
    "slug",
    "canonicalization",
    "lifecycle",
    "slug-lifecycle",
    "php",
    "maatify"
  ],
  "homepage": "https://github.com/Maatify/php-slug",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Maatify",
      "email": "support@maatify.dev",
      "homepage": "https://maatify.dev"
    }
  ],
  "support": {
    "issues": "https://github.com/Maatify/php-slug/issues",
    "source": "https://github.com/Maatify/php-slug"
  },
  "autoload": {
    "psr-4": {
      "Maatify\\Slug\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Maatify\\Slug\\Tests\\": "tests/"
    }
  },
  "require": {
    "ext-intl": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "maatify/exceptions": "^1.0",
    "maatify/persistence": "^1.1",
    "maatify/shared-common": "^1.0",
    "php": "^8.4"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "scripts": {
    "analyse": "phpstan analyse",
    "format": "php-cs-fixer fix",
    "test": "bash tools/ci/run-gate.sh test",
    "test:unit": "bash tools/ci/run-gate.sh test-unit",
    "test:integration": "bash tools/ci/run-gate.sh test-integration"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.4.0"
    },
    "policy": {
      "advisories": {
        "block": true,
        "audit": "fail"
      },
      "malware": {
        "block": true,
        "block-scope": "all",
        "audit": "fail"
      },
      "abandoned": {
        "block": false,
        "audit": "fail"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
